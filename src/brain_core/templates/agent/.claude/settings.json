{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-bash.sh\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "brain recall --hook --path \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brain capture --path \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brain capture --path \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brain brief --hook --path \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || command -v brain >/dev/null || echo 'brain-core: the brain command is not on PATH in this session, so its hooks (brief, capture, recall) are not running. Tell the user. Fix: run uv tool update-shell, then restart Claude Code.'"
          }
        ]
      }
    ]
  }
}
