{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.xy-claude/brain-core",
  "title": "brain-core",
  "description": "Memory for a Claude Code agent that survives the session: five tools, a markdown vault, all local.",
  "repository": {
    "url": "https://github.com/xy-claude/brain-core",
    "source": "github"
  },
  "websiteUrl": "https://github.com/xy-claude/brain-core#readme",
  "version": "0.4.6",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "brain-core-mcp",
      "version": "0.4.6",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve",
          "valueHint": "serve"
        },
        {
          "type": "positional",
          "valueHint": "agent_dir",
          "description": "The agent folder created by `brain init NAME`, holding brain.yaml.",
          "isRequired": true
        }
      ]
    }
  ]
}
